{
  "manifest_version": 3,
  "name": "Save to Companion",
  "version": "1.0.0",
  "description": "Save TikTok, Instagram, and Facebook links to your Ambient Companion download queue.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "contextMenus", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Save to Companion",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
